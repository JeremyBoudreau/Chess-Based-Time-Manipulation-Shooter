# Copy to .env.local and fill in. Only BETTER_AUTH_SECRET is required for local development.

# libsql connection URL. Local SQLite file by default (relative to apps/web, i.e. the repo root);
# use libsql://<db>.turso.io for Turso in production.
DATABASE_URL=file:../../buckshot.db

# Turso auth token. Leave empty for a local file database.
DATABASE_AUTH_TOKEN=

# Signs session cookies and tokens. Required in every environment (the server refuses to start
# without it, or AUTH_SECRET / BETTER_AUTH_SECRETS). Never commit it; rotate it if it ever leaks.
# Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Public origin of the app (used for redirects and the trusted-origin check).
BETTER_AUTH_URL=http://localhost:3000
