{
  "name": "buckshot-gambit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "db:push": "turbo run db:push --filter=@buckshot/db",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.2"
}
